# Teater Scenario
DirectoryIndex index.php index.html

# Gamle adresser fra den statiske version
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^om\.html$ om.php [R=301,L]
  RewriteRule ^forestillinger\.html$ forestillinger.php [R=301,L]
  RewriteRule ^index\.html$ index.php [R=301,L]
</IfModule>
